# Private Manager — Docker Compose production environment.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- PostgreSQL (compose constructs DATABASE_URL internally) ---
POSTGRES_DB=private_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Authentication (single user) ---
AUTH_USERNAME=
# Cost-12 bcrypt hash. Compose `.env` uses SINGLE quotes to preserve the
# literal bcrypt dollar signs, e.g. AUTH_PASSWORD_HASH='$2b$12$...'
AUTH_PASSWORD_HASH=
# Random secret of at least 32 bytes.
AUTH_SECRET=
AUTH_SESSION_DAYS=30
# Set to "false" only for trusted-LAN HTTP testing. Production defaults secure.
AUTH_COOKIE_SECURE=true

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=high
OPENAI_STORE=false

# --- Cloudflare tunnel (optional "tunnel" profile) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Developer debugging ---
# When "true", API errors include sanitized technical debug details to the
# browser. Server logs always contain sanitized diagnostics. Default: false.
DEBUG_ERROR_DETAILS=false
