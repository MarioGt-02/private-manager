# Private Manager — local development environment.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Database ---
# Use a direct connection string for local development, or let Docker Compose
# construct it from the POSTGRES_* variables instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/private_manager

# --- Authentication (single user) ---
AUTH_USERNAME=
# Cost-12 bcrypt hash. Generate one with: npm run auth:hash-password
AUTH_PASSWORD_HASH=
# Random secret of at least 32 bytes (e.g. `openssl rand -hex 32`).
AUTH_SECRET=
AUTH_SESSION_DAYS=30
# Set to "false" only for trusted-LAN HTTP testing. Production defaults secure.
AUTH_COOKIE_SECURE=

# --- OpenAI ---
# Server-side only. Never prefix with NEXT_PUBLIC_*.
OPENAI_API_KEY=
# Optional base URL for OpenAI-compatible providers.
OPENAI_BASE_URL=
# Model used by AI features (default: gpt-5.4-mini).
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=high
# Set "false" to disable provider-side response storage.
OPENAI_STORE=false

# --- Developer debugging ---
# When "true", API errors include sanitized technical debug details to the
# browser. Server logs always contain sanitized diagnostics. Default: false.
DEBUG_ERROR_DETAILS=false
